{
  "name": "falchion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.sim.config.ts",
    "build:sim": "vite build --config vite.sim.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "spec:validate": "openspec validate --all --strict",
    "thumbs": "node tools/thumbs/shoot.mjs",
    "planets": "node tools/planets/shoot.mjs",
    "planets:bench": "node tools/planets/bench.mjs",
    "planets:city": "node tools/planets/city.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.3",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
